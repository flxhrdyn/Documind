# InvenioAI - Environment Template
# Copy this file to .env and fill in required values.

# --- Required ---
# LLM answer generation (https://console.groq.com/keys)
GROQ_API_KEY=
# PDF extraction during indexing (https://cloud.llamaindex.ai/api-key)
LLAMA_CLOUD_API_KEY=

# --- Models ---
INVENIOAI_LLM_MODEL=openai/gpt-oss-20b
INVENIOAI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INVENIOAI_RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# --- Cache ---
CACHE_TYPE=diskcache
# Only used when CACHE_TYPE=redis. redis://redis:6379/0 in Docker Compose.
REDIS_URL=redis://localhost:6379/0
# L2 semantic cache: cosine similarity above which a query is served from cache.
INVENIOAI_SEMANTIC_CACHE_THRESHOLD=0.92

# --- Qdrant (optional - falls back to local storage at backend/qdrant_storage/) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=0

# --- Retrieval quality ---
# Dense + sparse (BM42) hybrid retrieval. 1 = enabled (default), 0 = dense-only.
INVENIOAI_ENABLE_HYBRID_SEARCH=1
# Reranker score above which a chunk counts as "relevant" for dashboard IR metrics.
INVENIOAI_IR_RELEVANCE_THRESHOLD=0.7

# --- API / server ---
# Set to require a matching X-API-Key header on protected endpoints. Empty = disabled.
INVENIOAI_API_KEY=
INVENIOAI_MAX_UPLOAD_SIZE_MB=100
# Comma-separated origins for browser clients calling this API directly.
INVENIOAI_ALLOWED_ORIGINS=*
# Where the Streamlit frontend finds this backend. Docker Compose sets this
# automatically to http://backend:8000.
INVENIOAI_API_BASE_URL=http://localhost:8000
INVENIOAI_DELETE_UPLOADED_PDFS=0

# --- Hugging Face Hub (increase if model downloads time out) ---
HF_HUB_CONNECT_TIMEOUT=30
HF_HUB_READ_TIMEOUT=120

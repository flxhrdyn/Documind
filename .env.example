# InvenioAI - Environment Template
# Copy this file to .env and fill in required values.

# --- Required ---
# Groq API key for Llama 3.1 8B LLM
GROQ_API_KEY=

# --- Cache Settings ---
# Choose caching backend: "diskcache" (default for local) or "redis"
CACHE_TYPE=diskcache
# If using redis, provide the URL
# Use redis://localhost:6379/0 for local development (outside Docker)
# Use redis://redis:6379/0 for Docker Compose deployments
REDIS_URL=redis://localhost:6379/0

# --- LLM & Retrieval Models ---
INVENIOAI_LLM_MODEL=llama-3.1-8b-instant
INVENIOAI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
INVENIOAI_RERANKER_MODEL=ms-marco-MiniLM-L-12-v2

# --- Optional: Qdrant (recommended for deployments / multi-process) ---
# If QDRANT_URL is not set, the app falls back to local storage at backend/qdrant_data/.
# QDRANT_URL examples:
#   http://localhost:6333
#   https://<your-qdrant-cloud-host>
QDRANT_URL=
QDRANT_API_KEY=

# Prefer gRPC when using Qdrant server/cloud (0/1). Default is REST (0).
QDRANT_PREFER_GRPC=0

# --- Optional: Hybrid retrieval (best-practice RAG) ---
# Enable dense + sparse (BM42) retrieval with Qdrant's native server-side RRF
# fusion before reranking. 1 = enabled (default), 0 = force dense-only.
# langchain-qdrant doesn't expose fusion weight knobs, so there are no
# separate dense/sparse weight settings here.
INVENIOAI_ENABLE_HYBRID_SEARCH=1

# --- Optional: analytics dashboard IR quality metrics ---
# Reranker score threshold above which a retrieved chunk counts as "relevant"
# for precision/recall/MRR/hit-rate. Assumes RERANKER_MODEL's scores are
# roughly normalized to [0, 1]; recalibrate if you swap reranker models.
INVENIOAI_IR_RELEVANCE_THRESHOLD=0.7

# --- Optional: API auth ---
# When set, upload/query/document/metrics endpoints require a matching
# X-API-Key header. Leave empty for local/demo use (auth disabled).
INVENIOAI_API_KEY=

# Max accepted PDF upload size in megabytes (server-side).
INVENIOAI_MAX_UPLOAD_SIZE_MB=100

# --- Optional: CORS (only matters for browser clients, e.g. a future React frontend) ---
# Comma-separated list of allowed origins. Defaults to "*" since the bundled
# Streamlit frontend calls this API server-side (not subject to CORS).
# When you point a browser app at this API directly, set explicit origins here
# to enable credentialed requests, e.g.:
# INVENIOAI_ALLOWED_ORIGINS=https://app.example.com,http://localhost:3000
INVENIOAI_ALLOWED_ORIGINS=*

# --- Optional: Streamlit -> Backend API base URL ---
# When running Streamlit separately (or deployed), point it to your FastAPI backend.
# In Docker Compose, this is automatically set to http://backend:8000
INVENIOAI_API_BASE_URL=http://localhost:8000

# --- Optional: Uploaded PDF lifecycle ---
# If enabled (1), PDFs are deleted from local disk after a successful indexing.
INVENIOAI_DELETE_UPLOADED_PDFS=0

# Optional: upload/indexing timeout (seconds) for Streamlit -> backend call.
# INVENIOAI_UPLOAD_TIMEOUT_SECONDS=600

# --- Optional: Hugging Face Hub download/network settings ---
# Increase timeouts if you see ReadTimeoutError while downloading models.
HF_HUB_CONNECT_TIMEOUT=30
HF_HUB_READ_TIMEOUT=120
